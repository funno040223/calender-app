# Supabase の接続先（値は Supabase のダッシュボードからコピーする）
# このファイルは見本です。実際の値は .env.local に書いてください（.env.local は git に載りません）

# プロジェクトの URL（https://xxxx.supabase.co の形）
NEXT_PUBLIC_SUPABASE_URL=

# 公開してよい鍵（sb_publishable_ で始まる。古いプロジェクトでは anon key）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 通知（Web Push）の鍵。`node -e 'console.log(require("web-push").generateVAPIDKeys())'` で作る
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 定期実行（Supabase の pg_cron）が /api/push/dispatch を呼ぶときの合言葉（長いランダムな文字列）
CRON_SECRET=

# Supabase の secret key（sb_secret_ で始まる）。サーバーだけで使う。画面には絶対に出さない
SUPABASE_SECRET_KEY=
